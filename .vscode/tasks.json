      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "DAILY RUN alias: start both servers against an existing once-seeded PostgreSQL demo. Use Setup once + Start Dev if not initialized."
    },
    {
      "label": "KATS: Unified demo backend (PostgreSQL / SQLite fallback)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\ops\\vscode_task.ps1",
        "-Target",
        "dev-backend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "kats-dev-parallel",
        "focus": false,
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [
        {
          "owner": "kats-native",
          "fileLocation": "relative",
          "pattern": {
            "regexp": "^\\[KATS-PROBLEM\\] (.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "endsPattern": "^\\[READY\\]"
          }
        }
      ],
      "isBackground": true,
      "detail": "LEFT VS Code terminal: start existing localhost PostgreSQL Flask API quickly with no pip, migrations or seeding. Warm startup can work even if ephemeral session file was cleaned."
    },
