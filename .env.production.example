# EXAMPLE ONLY. Replace every placeholder from an approved secrets manager.
# Keep the actual .env.production out of source control.
KATS_DOMAIN=replace.example.com
ACME_EMAIL=replace@example.com
APP_ENV=production
PUBLIC_APP_URL=https://replace.example.com
CORS_ORIGINS=https://replace.example.com
TRUSTED_HOSTS=replace.example.com
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
APP_BEHIND_TRUSTED_PROXY=true
DATABASE_URL=postgresql+psycopg://replace_app:REPLACE_DB_PASSWORD@replace-postgres.private:5432/kats?sslmode=verify-full
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
REDIS_URL=rediss://replace:REPLACE_REDIS_SECRET@replace-redis.private:6379/0
RATELIMIT_STORAGE_URI=rediss://replace:REPLACE_REDIS_SECRET@replace-redis.private:6379/0
CELERY_BROKER_URL=rediss://replace:REPLACE_REDIS_SECRET@replace-redis.private:6379/1
CELERY_RESULT_BACKEND=rediss://replace:REPLACE_REDIS_SECRET@replace-redis.private:6379/2
SECRET_KEY=REPLACE_WITH_INDEPENDENT_HIGH_ENTROPY_SECRET_32_PLUS
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_HIGH_ENTROPY_JWT_SECRET_32_PLUS
MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_FROM_SECRETS_MANAGER
RATELIMIT_ENABLED=true
PUBLIC_REGISTRATION_ENABLED=false
MTN_MOMO_ENABLED=false
AIRTEL_MONEY_ENABLED=false
EFRIS_ENABLED=false
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
