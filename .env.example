APP_ENV=development
DATABASE_URL=postgresql+psycopg://kats:devpassword@db:5432/kats
SECRET_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_32_PLUS_RANDOM_CHARACTERS
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
POSTGRES_DB=kats
POSTGRES_USER=kats
POSTGRES_PASSWORD=devpassword
PUBLIC_REGISTRATION_ENABLED=false
MTN_MOMO_ENABLED=false
AIRTEL_MONEY_ENABLED=false
EFRIS_ENABLED=false

# Optional providers: leave disabled until verified sandbox and contract acceptance
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
# EFRIS requires an approved signed/encrypted URA adapter and taxpayer registration
# EFRIS_ENABLED=false
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional organization-specific SMS and mail providers (not enabled by default)
SMS_PROVIDER_ENABLED=false
EMAIL_PROVIDER_ENABLED=false

# Secure invitation and password-recovery mail (SMTP implicit TLS :465 or STARTTLS :587)
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Production: use PUBLIC_APP_URL=https://<approved-domain> and explicit HTTPS CORS_ORIGINS

# Production hardening (review docs/PRODUCTION_SECURITY.md)
TRUSTED_HOSTS=
TRUST_PROXY_HEADERS=false
APP_BEHIND_TRUSTED_PROXY=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
JSON_MAX_BYTES=262144
RATELIMIT_ENABLED=true
# RATELIMIT_STORAGE_URI=rediss://<private-redis-host>:6379/0
# Production must use a separate non-superuser/non-BYPASSRLS DB application role.

# Private document scanning: required when S3_BUCKET is configured.
# Scanner must be private, trusted, and reachable over the isolated backend network.
# S3 bucket MUST have versioning enabled; downloads pin scanned VersionId.
CLAMAV_HOST=
CLAMAV_PORT=3310
