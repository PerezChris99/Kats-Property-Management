# KATS Vercel + Neon synthetic-demo deployment template.
# Never commit real values or use a public demo for actual tenants/payments.
APP_ENV=production
KATS_PREVIEW_MODE=0
KATS_PUBLIC_DEMO_SEED=0
COOKIE_SECURE=true
PUBLIC_REGISTRATION_ENABLED=false
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=https://katsproperty.vercel.app
TRUSTED_HOSTS=katsproperty.vercel.app
DATABASE_URL=postgresql+psycopg://kats_runtime:REPLACE_RUNTIME_CREDENTIAL@ep-REPLACE-pooler.us-east-1.aws.neon.tech/katsproperty?sslmode=verify-full
SECRET_KEY=REPLACE_INDEPENDENT_32_PLUS_CHARACTER_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_DIFFERENT_32_PLUS_CHARACTER_RANDOM_JWT_SECRET
# Current KATS architecture requires working managed TLS Redis for
# shared rate limiting, Celery broker and results until Vercel Queues
# integration is independently tested. Do not silently use memory://.
REDIS_URL=rediss://REPLACE_MANAGED_REDIS
RATELIMIT_STORAGE_URI=rediss://REPLACE_MANAGED_REDIS
CELERY_BROKER_URL=rediss://REPLACE_MANAGED_REDIS
CELERY_RESULT_BACKEND=rediss://REPLACE_MANAGED_REDIS
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=5
DB_CONNECTION_BUDGET=30
API_WORKERS=1
CELERY_WORKER_CONCURRENCY=1
MTN_MOMO_ENABLED=false
AIRTEL_MONEY_ENABLED=false
EFRIS_ENABLED=false
# The password below is INTENTIONALLY PUBLIC and must match the
# synthetic-only one-off seed. Never use it for any actual account.
VITE_KATS_PUBLIC_DEMO=true
VITE_KATS_DEMO_PASSWORD=REPLACE_WITH_PUBLIC_SYNTHETIC_DEMO_PASSWORD
