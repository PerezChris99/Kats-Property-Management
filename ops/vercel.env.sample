# CLIENT REVIEW / VERCEL PRO ONLY — isolated fictional Kats Properties dataset.
# This is an EXAMPLE, never import .env into Git and never use production data.
# Vercel: set project Root Directory to repository root, using vercel.json
# services.web (frontend) and services.api (backend).
# Vercel supplies VERCEL, VERCEL_ENV, VERCEL_URL automatically. DO NOT set them.
#
# Backend runtime: environment=Preview (and Production ONLY for an explicitly
# approved client-review hostname). Keep the eventual Hostwares environment
# completely separate, including its database, queues, keys and accounts.
APP_ENV=production
KATS_PREVIEW_MODE=0
KATS_PUBLIC_DEMO_SEED=0
PUBLIC_REGISTRATION_ENABLED=false
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=false
# Explicit operator-approved stable review domain. The backend additionally
# validates and permits the EXACT Vercel-generated deployment host on each run.
CORS_ORIGINS=https://REPLACE_APPROVED_REVIEW_HOST.vercel.app
TRUSTED_HOSTS=REPLACE_APPROVED_REVIEW_HOST.vercel.app
PUBLIC_APP_URL=https://REPLACE_APPROVED_REVIEW_HOST.vercel.app
#
# RESTRICTED runtime DB user, not the migration owner. Use an isolated,
# migrated PostgreSQL database backed up independently of Hostwares.
# Pooler for elastic Vercel functions. Certificate verification required.
DATABASE_URL=postgresql+psycopg://kats_runtime:REPLACE_RUNTIME_CREDENTIAL@ep-REPLACE-pooler.us-east-1.aws.neon.tech/katsproperty?sslmode=verify-full
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=5
DB_CONNECTION_BUDGET=30
API_WORKERS=1
CELERY_WORKER_CONCURRENCY=1
#
# Shared managed TLS Redis required for the rate limiter; if work queues are
# exercised, a SEPARATE always-on Celery worker + single beat scheduler is
# also required. Vercel Functions do not run persistent workers.
REDIS_URL=rediss://REPLACE_MANAGED_REDIS
RATELIMIT_STORAGE_URI=rediss://REPLACE_MANAGED_REDIS
CELERY_BROKER_URL=rediss://REPLACE_MANAGED_REDIS
CELERY_RESULT_BACKEND=rediss://REPLACE_MANAGED_REDIS
#
# Independent random secrets set only in Vercel's encrypted project settings.
SECRET_KEY=REPLACE_INDEPENDENT_HIGH_ENTROPY_SECRET_AT_LEAST_32_CHARS
JWT_SECRET_KEY=REPLACE_SEPARATE_HIGH_ENTROPY_JWT_SECRET_AT_LEAST_32_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_VALID_FERNET_KEY
#
# Block any live financial providers and public provisioning during review.
MTN_MOMO_ENABLED=false
AIRTEL_MONEY_ENABLED=false
EFRIS_ENABLED=false
#
# Default client testing: invite explicitly authorized reviewers; no password
# or synthetic account credential ever needs to be embedded in the JS bundle.
VITE_KATS_PUBLIC_DEMO=false
# OPTIONAL — ONLY for access-protected, fictional seeded demo, all records
# synthetic and all credentials understood to be publicly readable in JS:
# VITE_KATS_PUBLIC_DEMO=true
# VITE_KATS_DEMO_PASSWORD=REPLACE_PUBLIC_SYNTHETIC_ONLY_PASSWORD
#
# To test invitations and password recovery: set SMTP_* and MAIL_FROM using
# an approved TEST email provider and domain (never real tenant addresses).
